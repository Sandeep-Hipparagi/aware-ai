# aware.ai Environment Configuration
# Copy to .env and fill in values

# Redis
REDIS_URL=redis://localhost:6379

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (for future cloud providers)
# SARVAM_API_KEY=
# NVIDIA_API_KEY=
# TOKENROUTER_API_KEY=

# Logging
LOG_LEVEL=INFO

# Guardrail Settings
GUARDRAIL_MAX_PROMPT_LENGTH=100000
GUARDRAIL_MAX_RESPONSE_LENGTH=50000
GUARDRAIL_ENABLED_CHECKS=pii,injection,toxicity,length,hallucination

# Orchestrator
ORCHESTRATOR_TIMEOUT_SECONDS=120
ORCHESTRATOR_CHECKPOINT_TTL=86400